# App Configuration
PORT=4002
NODE_ENV=development
# Logging mode: verbose | traffic | cache | outgoing | clean (or comma-separated: e.g. traffic,cache)
LOGGING=verbose

# Optional Provider API Keys
IPINFO_TOKEN=

# Provider Execution Order (0=ipinfo.io, 1=freeipapi.com, 2=ip-api.com, 3=country.is, 4=hackertarget.com)
# Example (fetch ipinfo last): PROVIDER_ORDER="1,2,3,4,0"
PROVIDER_ORDER=

# Redis Cache (Optional - falls back to in-memory cache if disabled or unreachable)
REDIS_ENABLED=false
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=geoip:

# Redis Sentinel (Optional)
REDIS_SENTINEL_NAME=mymaster
REDIS_SENTINELS= # (ip:port,ip:port,...)
REDIS_SENTINEL_PASSWORD=
# Docker NAT port forwarding (internalIP:port=externalIP:port or JSON)
REDIS_NAT_MAP=

# Redis TLS (Optional)
REDIS_TLS=false
REDIS_TLS_CA=
REDIS_TLS_CERT=
REDIS_TLS_KEY=
REDIS_TLS_REJECT_UNAUTHORIZED=true
